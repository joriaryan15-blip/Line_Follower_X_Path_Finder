// ============================================================
//                    IR SENSOR PINS
// ==========================================================
const int IR1 = 34;
const int IR2 = 35;
const int IR3 = 32;
const int IR4 = 33;
const int IR5 = 25;

const int irPins[5] = {
  IR1,
  IR2,
  IR3,
  IR4,
  IR5
};

// ============================================================
//                    MOTOR PINS
// ============================================================

// Motor A
const int AIN1 = 27;
const int AIN2 = 14;
const int PWMA = 13;

// Motor B
const int BIN1 = 17;
const int BIN2 = 16;
const int PWMB = 4;

// TB6612 Standby
const int STBY = 26;


// ============================================================
//                    PID PARAMETERS
// ============================================================

float Kp = 45.0;
float Ki = 0.0;
float Kd = 25.0;


// ============================================================
//                    SPEED PARAMETERS
// ============================================================

int BASE_SPEED = 150;

int MAX_SPEED = 255;

int MIN_SPEED = 0;


// ============================================================
//                    SENSOR PARAMETERS
// ============================================================

// Change this according to your sensor.
//
// If BLACK line gives HIGH ADC value:
//     LINE_IS_HIGH = true
//
// If BLACK line gives LOW ADC value:
//     LINE_IS_HIGH = false

bool LINE_IS_HIGH = true;


// Minimum sensor value considered useful.
// This may need to be changed according to your IR sensor.
const int SENSOR_THRESHOLD = 1500;


// ============================================================
//                    PID VARIABLES
// ============================================================

float error = 0;
float previousError = 0;

float integral = 0;

float derivative = 0;

float correction = 0;


// ============================================================
//                    SENSOR VARIABLES
// ============================================================

int sensorValue[5];

int sensorBinary[5];


// Last known position of line.
// Useful when the robot temporarily loses the line.

float lastPosition = 0;


// ============================================================
//                    MOTOR FUNCTIONS
// ============================================================

void setMotorA(int speed)
{
  speed = constrain(speed, -255, 255);

  if (speed > 0)
  {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);

    analogWrite(PWMA, speed);
  }

  else if (speed < 0)
  {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);

    analogWrite(PWMA, -speed);
  }

  else
  {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, LOW);

    analogWrite(PWMA, 0);
  }
}


// ------------------------------------------------------------

void setMotorB(int speed)
{
  speed = constrain(speed, -255, 255);

  if (speed > 0)
  {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);

    analogWrite(PWMB, speed);
  }

  else if (speed < 0)
  {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);

    analogWrite(PWMB, -speed);
  }

  else
  {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, LOW);

    analogWrite(PWMB, 0);
  }
}


// ============================================================
//                    DRIVE FUNCTION
// ============================================================

void drive(int leftSpeed, int rightSpeed)
{
  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  setMotorA(leftSpeed);
  setMotorB(rightSpeed);
}


// ============================================================
//                    STOP ROBOT
// ============================================================

void stopRobot()
{
  drive(0, 0);
}


// ============================================================
//                    READ IR SENSORS
// ============================================================

void readSensors()
{
  for (int i = 0; i < 5; i++)
  {
    sensorValue[i] = analogRead(irPins[i]);
  }
}


// ============================================================
//                    CONVERT TO BINARY
// ============================================================

void convertSensors()
{
  for (int i = 0; i < 5; i++)
  {
    if (LINE_IS_HIGH)
    {
      if (sensorValue[i] > SENSOR_THRESHOLD)
        sensorBinary[i] = 1;
      else
        sensorBinary[i] = 0;
    }

    else
    {
      if (sensorValue[i] < SENSOR_THRESHOLD)
        sensorBinary[i] = 1;
      else
        sensorBinary[i] = 0;
    }
  }
}


// ============================================================
//                    CALCULATE LINE POSITION
// ============================================================

float calculatePosition()
{
  /*
       Sensor positions:

       S1 = -2
       S2 = -1
       S3 =  0
       S4 = +1
       S5 = +2
  */

  float position[5] = {
    -2.0,
    -1.0,
     0.0,
     1.0,
     2.0
  };


  float weightedSum = 0;
  float totalWeight = 0;


  for (int i = 0; i < 5; i++)
  {
    if (sensorBinary[i] == 1)
    {
      weightedSum += position[i];
      totalWeight += 1;
    }
  }


  // ----------------------------------------------------------
  // Line detected
  // ----------------------------------------------------------

  if (totalWeight > 0)
  {
    float currentPosition = weightedSum / totalWeight;

    lastPosition = currentPosition;

    return currentPosition;
  }


  // ----------------------------------------------------------
  // Line lost
  // ----------------------------------------------------------

  return lastPosition;
}


// ============================================================
//                    PID CONTROL
// ============================================================

void calculatePID(float position)
{
  /*
      Desired position = 0

      Therefore:

      Error = 0 - actual position
  */

  error = 0 - position;


  // ----------------------------------------------------------
  // Integral
  // ----------------------------------------------------------

  integral += error;


  // Prevent integral wind-up
  integral = constrain(integral, -100, 100);


  // ----------------------------------------------------------
  // Derivative
  // ----------------------------------------------------------

  derivative = error - previousError;


  // ----------------------------------------------------------
  // PID
  // ----------------------------------------------------------

  correction =
      (Kp * error)
    + (Ki * integral)
    + (Kd * derivative);


  previousError = error;
}


// ============================================================
//                    APPLY PID
// ============================================================

void applyPID()
{
  /*
      If line is on LEFT:

      error becomes positive
      correction becomes positive

      Left motor becomes faster
      Right motor becomes slower

      Robot turns LEFT/RIGHT depending on motor orientation.

      If your robot turns in the wrong direction,
      simply reverse the correction signs below.
  */


  int leftSpeed  = BASE_SPEED + correction;
  int rightSpeed = BASE_SPEED - correction;


  leftSpeed = constrain(leftSpeed, MIN_SPEED, MAX_SPEED);

  rightSpeed = constrain(rightSpeed, MIN_SPEED, MAX_SPEED);


  drive(leftSpeed, rightSpeed);
}


// ============================================================
//                    DEBUG SENSOR VALUES
// ============================================================

void printSensors()
{
  Serial.print("RAW: ");

  for (int i = 0; i < 5; i++)
  {
    Serial.print(sensorValue[i]);

    if (i < 4)
      Serial.print(" | ");
  }

  Serial.print("    BIN: ");

  for (int i = 0; i < 5; i++)
  {
    Serial.print(sensorBinary[i]);
    Serial.print(" ");
  }

  Serial.print("    Error: ");
  Serial.print(error);

  Serial.print("    Correction: ");
  Serial.println(correction);
}


// ============================================================
//                    SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);


  // ----------------------------------------------------------
  // IR sensor pins
  // ----------------------------------------------------------

  pinMode(IR1, INPUT);
  pinMode(IR2, INPUT);
  pinMode(IR3, INPUT);
  pinMode(IR4, INPUT);
  pinMode(IR5, INPUT);


  // ----------------------------------------------------------
  // Motor pins
  // ----------------------------------------------------------

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);


  // ----------------------------------------------------------
  // TB6612 standby
  // ----------------------------------------------------------

  pinMode(STBY, OUTPUT);

  digitalWrite(STBY, HIGH);


  // ----------------------------------------------------------
  // Stop motors initially
  // ----------------------------------------------------------

  stopRobot();


  Serial.println();
  Serial.println("==============================");
  Serial.println("   ESP32 PID LINE FOLLOWER");
  Serial.println("==============================");

  delay(1000);
}


// ============================================================
//                    MAIN LOOP
// ============================================================

void loop()
{
  // ----------------------------------------------------------
  // Read IR sensors
  // ----------------------------------------------------------

  readSensors();


  // ----------------------------------------------------------
  // Convert sensor readings
  // ----------------------------------------------------------

  convertSensors();


  // ----------------------------------------------------------
  // Calculate line position
  // ----------------------------------------------------------

  float position = calculatePosition();


  // ----------------------------------------------------------
  // Calculate PID
  // ----------------------------------------------------------

  calculatePID(position);


  // ----------------------------------------------------------
  // Apply correction
  // ----------------------------------------------------------

  applyPID();


  // ----------------------------------------------------------
  // Debug
  // ----------------------------------------------------------

  printSensors();


  delay(5);
}
