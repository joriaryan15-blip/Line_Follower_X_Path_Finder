#include <Wire.h>
#include <VL53L0X.h>

// ============================================================
//                    PIN DEFINITIONS
// ============================================================

// ---------- I2C ----------
#define SDA_PIN 21
#define SCL_PIN 22

// ---------- TB6612FNG ----------
#define AIN1 27
#define AIN2 14
#define PWMA 13

#define BIN1 17
#define BIN2 16
#define PWMB 4

#define STBY 26

// ---------- VL53L0X XSHUT ----------
#define XSHUT_LEFT  5
#define XSHUT_RIGHT 18
#define XSHUT_FRONT 19


// ============================================================
//                    SENSOR OBJECTS
// ============================================================

VL53L0X sensorLeft;
VL53L0X sensorRight;
VL53L0X sensorFront;


// ============================================================
//                    SENSOR ADDRESSES
// ============================================================

#define LEFT_ADDRESS  0x30
#define RIGHT_ADDRESS 0x31
#define FRONT_ADDRESS 0x32


// ============================================================
//                    ROBOT PARAMETERS
// ============================================================

// Maximum motor PWM
const int MAX_PWM = 255;

// Normal forward speed
const int BASE_SPEED = 150;

// Minimum speed during wall correction
const int MIN_SPEED = 80;

// Target distance from right wall in mm
const int TARGET_RIGHT_DISTANCE = 120;

// Front obstacle threshold
const int FRONT_THRESHOLD = 180;

// Minimum distance considered an open path
const int OPEN_DISTANCE = 200;

// Very close wall
const int WALL_TOO_CLOSE = 60;


// ============================================================
//                    WALL CONTROL
// ============================================================

// Proportional gain for wall following
float KP_WALL = 1.2;


// ============================================================
//                    TURN PARAMETERS
// ============================================================

// These values MUST be tuned experimentally.
// They depend on motor speed, battery voltage,
// robot dimensions and floor surface.

const int TURN_SPEED = 170;

// Time required approximately for 90 degree turn
const unsigned long TURN_90_TIME = 420;

// Time required approximately for 180 degree turn
const unsigned long TURN_180_TIME = 840;


// ============================================================
//                    SENSOR VARIABLES
// ============================================================

int leftDistance  = 0;
int rightDistance = 0;
int frontDistance = 0;


// ============================================================
//                    MOTOR FUNCTIONS
// ============================================================

void motorA(int speed)
{
  speed = constrain(speed, -255, 255);

  if (speed > 0)
  {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
    analogWrite(PWMA, speed);
  }
  else if (speed < 0)
  {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
    analogWrite(PWMA, -speed);
  }
  else
  {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, LOW);
    analogWrite(PWMA, 0);
  }
}


void motorB(int speed)
{
  speed = constrain(speed, -255, 255);

  if (speed > 0)
  {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
    analogWrite(PWMB, speed);
  }
  else if (speed < 0)
  {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
    analogWrite(PWMB, -speed);
  }
  else
  {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, LOW);
    analogWrite(PWMB, 0);
  }
}


void setMotors(int leftSpeed, int rightSpeed)
{
  motorA(leftSpeed);
  motorB(rightSpeed);
}


void stopMotors()
{
  setMotors(0, 0);
}


// ============================================================
//                    BASIC MOVEMENT
// ============================================================

void moveForward()
{
  setMotors(BASE_SPEED, BASE_SPEED);
}


void moveBackward()
{
  setMotors(-BASE_SPEED, -BASE_SPEED);
}


void turnRight90()
{
  Serial.println("TURN RIGHT");

  // Differential-drive clockwise rotation
  setMotors(TURN_SPEED, -TURN_SPEED);

  delay(TURN_90_TIME);

  stopMotors();

  delay(100);
}


void turnLeft90()
{
  Serial.println("TURN LEFT");

  // Differential-drive counter-clockwise rotation
  setMotors(-TURN_SPEED, TURN_SPEED);

  delay(TURN_90_TIME);

  stopMotors();

  delay(100);
}


void turnAround()
{
  Serial.println("U-TURN");

  setMotors(TURN_SPEED, -TURN_SPEED);

  delay(TURN_180_TIME);

  stopMotors();

  delay(100);
}


// ============================================================
//                    SENSOR INITIALIZATION
// ============================================================

void initializeSensors()
{
  Serial.println("Initializing VL53L0X sensors...");

  // Start with all sensors disabled
  pinMode(XSHUT_LEFT, OUTPUT);
  pinMode(XSHUT_RIGHT, OUTPUT);
  pinMode(XSHUT_FRONT, OUTPUT);

  digitalWrite(XSHUT_LEFT, LOW);
  digitalWrite(XSHUT_RIGHT, LOW);
  digitalWrite(XSHUT_FRONT, LOW);

  delay(100);


  // ----------------------------------------------------------
  // LEFT SENSOR
  // ----------------------------------------------------------

  digitalWrite(XSHUT_LEFT, HIGH);
  delay(50);

  if (!sensorLeft.init())
  {
    Serial.println("ERROR: Left VL53L0X not detected!");
    while (1);
  }

  sensorLeft.setAddress(LEFT_ADDRESS);

  sensorLeft.setTimeout(100);

  sensorLeft.startContinuous();


  // ----------------------------------------------------------
  // RIGHT SENSOR
  // ----------------------------------------------------------

  digitalWrite(XSHUT_RIGHT, HIGH);
  delay(50);

  if (!sensorRight.init())
  {
    Serial.println("ERROR: Right VL53L0X not detected!");
    while (1);
  }

  sensorRight.setAddress(RIGHT_ADDRESS);

  sensorRight.setTimeout(100);

  sensorRight.startContinuous();


  // ----------------------------------------------------------
  // FRONT SENSOR
  // ----------------------------------------------------------

  digitalWrite(XSHUT_FRONT, HIGH);
  delay(50);

  if (!sensorFront.init())
  {
    Serial.println("ERROR: Front VL53L0X not detected!");
    while (1);
  }

  sensorFront.setAddress(FRONT_ADDRESS);

  sensorFront.setTimeout(100);

  sensorFront.startContinuous();


  Serial.println("All VL53L0X sensors initialized.");
}


// ============================================================
//                    READ SENSORS
// ============================================================

void readSensors()
{
  leftDistance  = sensorLeft.readRangeContinuousMillimeters();
  rightDistance = sensorRight.readRangeContinuousMillimeters();
  frontDistance = sensorFront.readRangeContinuousMillimeters();

  // Handle timeout
  if (sensorLeft.timeoutOccurred())
    leftDistance = 2000;

  if (sensorRight.timeoutOccurred())
    rightDistance = 2000;

  if (sensorFront.timeoutOccurred())
    frontDistance = 2000;
}


// ============================================================
//                    PRINT SENSOR DATA
// ============================================================

void printSensors()
{
  Serial.print("L: ");
  Serial.print(leftDistance);

  Serial.print(" mm | R: ");
  Serial.print(rightDistance);

  Serial.print(" mm | F: ");
  Serial.print(frontDistance);

  Serial.println(" mm");
}


// ============================================================
//                    PATH CONDITIONS
// ============================================================

bool rightOpen()
{
  return rightDistance > OPEN_DISTANCE;
}


bool frontOpen()
{
  return frontDistance > FRONT_THRESHOLD;
}


bool leftOpen()
{
  return leftDistance > OPEN_DISTANCE;
}


// ============================================================
//                    WALL FOLLOWING
// ============================================================

void followRightWall()
{
  /*
     Error definition:

     Positive error:
     Robot is too far from right wall.

     Negative error:
     Robot is too close to right wall.
  */

  int error = TARGET_RIGHT_DISTANCE - rightDistance;

  float correction = KP_WALL * error;

  int leftSpeed  = BASE_SPEED + correction;
  int rightSpeed = BASE_SPEED - correction;

  leftSpeed = constrain(leftSpeed, MIN_SPEED, MAX_PWM);
  rightSpeed = constrain(rightSpeed, MIN_SPEED, MAX_PWM);

  setMotors(leftSpeed, rightSpeed);
}


// ============================================================
//                    PATH FINDING LOGIC
// ============================================================

void pathFinding()
{
  readSensors();

  printSensors();


  // ----------------------------------------------------------
  // CASE 1:
  // RIGHT SIDE IS OPEN
  // ----------------------------------------------------------

  if (rightOpen())
  {
    stopMotors();

    delay(50);

    turnRight90();

    return;
  }


  // ----------------------------------------------------------
  // CASE 2:
  // FRONT IS OPEN
  // ----------------------------------------------------------

  if (frontOpen())
  {
    followRightWall();

    return;
  }


  // ----------------------------------------------------------
  // CASE 3:
  // FRONT BLOCKED BUT LEFT IS OPEN
  // ----------------------------------------------------------

  if (leftOpen())
  {
    stopMotors();

    delay(50);

    turnLeft90();

    return;
  }


  // ----------------------------------------------------------
  // CASE 4:
  // ALL DIRECTIONS BLOCKED
  // ----------------------------------------------------------

  stopMotors();

  delay(100);

  turnAround();
}


// ============================================================
//                    SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("==============================");
  Serial.println(" VL53L0X PATH FINDER ROBOT");
  Serial.println("==============================");


  // ----------------------------------------------------------
  // Motor pins
  // ----------------------------------------------------------

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);

  pinMode(STBY, OUTPUT);

  digitalWrite(STBY, HIGH);

  stopMotors();


  // ----------------------------------------------------------
  // I2C
  // ----------------------------------------------------------

  Wire.begin(SDA_PIN, SCL_PIN);


  // ----------------------------------------------------------
  // Sensors
  // ----------------------------------------------------------

  initializeSensors();

  delay(1000);

  Serial.println("Path finder ready.");

  delay(1000);
}


// ============================================================
//                    MAIN LOOP
// ============================================================

void loop()
{
  pathFinding();

  delay(20);
}
